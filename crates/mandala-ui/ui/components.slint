import { ThemePalette, Scale } from "theme_tokens.slint";

// Keyboard model: every control carries a FocusScope. Slint's window walks
// the focus chain on Tab/Shift+Tab, so the loop reaches the command bar and
// every visible control; Enter or Space activates the focused one. The ring
// is the theme accent, drawn instantly, and only ever appears for Tab focus
// (zero-geometry FocusScopes are never hit by a pointer, so mouse users see
// no ring).
// shortcut: Escape while a control has focus bubbles to the window and is
// dropped there — the same path the command input has always had. Overlay
// close works from the default focus state and via the CLOSE buttons.

// One rendered panel position or All-Apps row: an app (id set) or an empty
// holder (placeholder). `icon` is a monogram glyph computed in Rust — no
// image assets, consistent with the text-first design. `accent` is the
// app's own theme colour (derived per id in Rust), so every installed app
// keeps a stable identity across themes.
export struct SlotItem {
    id: string,
    label: string,
    icon: string,
    placeholder: bool,
    accent: color,
}

// One row of the module-store overlay. `status` is pre-rendered by the
// reducer (INSTALL / UPDATE / INSTALLED ✓ / INSTALLING…); `actionable` says
// whether tapping it starts an install.
export struct StoreItem {
    id: string,
    label: string,
    description: string,
    version: string,
    status: string,
    actionable: bool,
}

// Square-ish icon tile + label. Used by the bottom dock (Panel A) and the
// always-visible side rails. A placeholder is an empty app holder: tapping it
// opens the Store so the user can fill the slot.
export component SlotButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> placeholder: false;
    in property <color> accent: ThemePalette.accent-focus;
    // False while the control sits behind an overlay/drawer: it then drops
    // out of the Tab loop instead of parking focus on an invisible ring.
    in property <bool> focusable: true;
    callback activated();
    callback open-store();

    background: (touch.pressed || (touch.has-hover && !root.placeholder)) ? ThemePalette.surface-border : ThemePalette.surface-primary;
    border-radius: ThemePalette.corner-radius;
    border-width: fs.has-focus ? Scale.ring-width : ThemePalette.border-width;
    border-color: fs.has-focus ? ThemePalette.accent-focus : (placeholder ? ThemePalette.canvas-bg : ThemePalette.surface-border);
    opacity: placeholder ? 0.45 : 1.0;

    function trigger() {
        if (root.placeholder) {
            root.open-store();
        } else {
            root.activated();
        }
    }

    VerticalLayout {
        alignment: center;
        padding: Scale.space-1;
        spacing: Scale.space-half;

        // Monogram icon tile.
        Rectangle {
            height: 28px;
            width: 28px;
            x: (parent.width - self.width) / 2;
            background: ThemePalette.canvas-bg;
            border-radius: ThemePalette.corner-radius;
            border-width: ThemePalette.border-width;
            border-color: ThemePalette.surface-border;

            Text {
                text: root.placeholder ? "+" : root.icon;
                color: root.placeholder ? ThemePalette.text-secondary : root.accent;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-icon;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.placeholder ? "" : root.label;
            color: ThemePalette.text-primary;
            font-family: ThemePalette.font-family;
            font-size: Scale.font-label;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    fs := FocusScope {
        enabled: root.focusable;
        key-pressed(e) => {
            // Modifier chords bubble to the window (Ctrl+Space, Ctrl+T);
            // only a bare Enter/Space activates the control.
            if (e.text == "\n" || e.text == " ") && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                root.trigger();
                accept
            } else {
                // Tab falls through to the window's focus loop.
                reject
            }
        }
    }

    touch := TouchArea {
        clicked => { root.trigger(); }
    }
}

// Narrow rail tile for the always-visible side columns: monogram only, no
// label — the rail is ~76px wide and labels would truncate to nothing.
export component RailTile inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> placeholder: false;
    in property <color> accent: ThemePalette.accent-focus;
    in property <bool> focusable: true;
    callback activated();
    callback open-store();

    height: 56px;
    background: (ta.pressed || (ta.has-hover && !root.placeholder)) ? ThemePalette.surface-border : ThemePalette.canvas-bg;
    border-radius: ThemePalette.corner-radius;
    border-width: fs.has-focus ? Scale.ring-width : ThemePalette.border-width;
    border-color: fs.has-focus ? ThemePalette.accent-focus : ThemePalette.surface-border;
    opacity: placeholder ? 0.35 : 1.0;

    function trigger() {
        if (root.placeholder) {
            root.open-store();
        } else {
            root.activated();
        }
    }

    Rectangle {
        height: 32px;
        width: 32px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: ThemePalette.surface-primary;
        border-radius: ThemePalette.corner-radius;

        Text {
            text: root.placeholder ? "+" : root.icon;
            color: root.placeholder ? ThemePalette.text-secondary : root.accent;
            font-family: ThemePalette.font-family;
            font-size: Scale.font-icon;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    fs := FocusScope {
        enabled: root.focusable;
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                root.trigger();
                accept
            } else {
                reject
            }
        }
    }

    // Long-press (or tap on placeholder) surfaces the label + opens store.
    ta := TouchArea {
        clicked => { root.trigger(); }
    }
}

// Full-width row used inside the side drawers and the All Apps overlay.
export component SlotRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> placeholder: false;
    in property <color> accent: ThemePalette.accent-focus;
    in property <bool> focusable: true;
    callback activated();
    callback open-store();

    height: 52px;
    background: (touch.pressed || (touch.has-hover && !root.placeholder)) ? ThemePalette.surface-border : ThemePalette.canvas-bg;
    border-radius: ThemePalette.corner-radius;
    border-width: fs.has-focus ? Scale.ring-width : ThemePalette.border-width;
    border-color: fs.has-focus ? ThemePalette.accent-focus : (placeholder ? ThemePalette.canvas-bg : ThemePalette.surface-border);
    opacity: placeholder ? 0.45 : 1.0;

    function trigger() {
        if (root.placeholder) {
            root.open-store();
        } else {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: Scale.space-3;
        padding-right: Scale.space-3;
        spacing: Scale.space-3;

        Rectangle {
            width: 32px;
            height: 32px;
            background: ThemePalette.surface-primary;
            border-radius: ThemePalette.corner-radius;

            Text {
                text: root.placeholder ? "+" : root.icon;
                color: root.placeholder ? ThemePalette.text-secondary : root.accent;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-icon;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.placeholder ? "add from store" : root.label;
            color: root.placeholder ? ThemePalette.text-secondary : ThemePalette.text-primary;
            font-family: ThemePalette.font-family;
            font-size: Scale.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    fs := FocusScope {
        enabled: root.focusable;
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                root.trigger();
                accept
            } else {
                reject
            }
        }
    }

    touch := TouchArea {
        clicked => { root.trigger(); }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    // Primary actions (install, exit) carry the theme's CTA colour.
    in property <bool> primary: false;
    in property <bool> focusable: true;
    callback clicked();

    height: Scale.control-height;
    background: touch.pressed ? ThemePalette.surface-border : (root.primary ? ThemePalette.cta-accent : (touch.has-hover ? ThemePalette.surface-border : ThemePalette.surface-primary));
    border-radius: ThemePalette.corner-radius;
    border-width: fs.has-focus ? Scale.ring-width : ThemePalette.border-width;
    border-color: fs.has-focus ? ThemePalette.accent-focus : ThemePalette.surface-border;

    Text {
        text: root.text;
        color: root.primary ? ThemePalette.on-cta : ThemePalette.text-primary;
        font-family: ThemePalette.font-family;
        font-size: Scale.font-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    fs := FocusScope {
        enabled: root.focusable;
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Status-bar pill (waybar module): a small chip with one line of live text.
// No pointer handling and never in the Tab loop — the bar is status only.
export component BarPill inherits Rectangle {
    in property <string> text;
    // Accent outline marks the theme pill (border = non-text contrast only).
    in property <bool> accent: false;

    height: Scale.bar-height - (Scale.space-1 * 2);
    background: ThemePalette.canvas-bg;
    border-radius: ThemePalette.corner-radius;
    border-width: ThemePalette.border-width;
    border-color: root.accent ? ThemePalette.accent-focus : ThemePalette.surface-border;

    HorizontalLayout {
        padding-left: Scale.space-2;
        padding-right: Scale.space-2;
        Text {
            text: root.text;
            color: ThemePalette.text-primary;
            font-family: ThemePalette.font-family;
            font-size: Scale.font-caption;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
