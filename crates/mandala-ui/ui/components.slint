import { ThemePalette } from "theme_tokens.slint";

export struct SlotItem {
    id: string,
    tag: string,
    label: string,
}

// Compact square-ish button used by the bottom dock (Panel A).
export component SlotButton inherits Rectangle {
    in property <string> tag;
    in property <string> label;
    callback activated();

    background: touch.pressed ? ThemePalette.surface-border : ThemePalette.surface-primary;
    border-radius: ThemePalette.corner-radius;
    border-width: ThemePalette.border-width;
    border-color: ThemePalette.surface-border;

    VerticalLayout {
        alignment: center;
        padding: 4px;
        spacing: 2px;
        Text {
            text: root.tag;
            color: ThemePalette.accent-focus;
            font-family: ThemePalette.font-family;
            font-size: 10px;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: ThemePalette.text-primary;
            font-family: ThemePalette.font-family;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

// Full-width row used inside the side drawers (Panels B and C).
export component SlotRow inherits Rectangle {
    in property <string> tag;
    in property <string> label;
    callback activated();

    height: 52px;
    background: touch.pressed ? ThemePalette.surface-border : ThemePalette.canvas-bg;
    border-radius: ThemePalette.corner-radius;
    border-width: ThemePalette.border-width;
    border-color: ThemePalette.surface-border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Text {
            text: root.tag;
            color: ThemePalette.accent-focus;
            font-family: ThemePalette.font-family;
            font-size: 12px;
            vertical-alignment: center;
            min-width: 24px;
        }
        Text {
            text: root.label;
            color: ThemePalette.text-primary;
            font-family: ThemePalette.font-family;
            font-size: 15px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 48px;
    background: touch.pressed ? ThemePalette.surface-border : ThemePalette.surface-primary;
    border-radius: ThemePalette.corner-radius;
    border-width: ThemePalette.border-width;
    border-color: ThemePalette.surface-border;

    Text {
        text: root.text;
        color: ThemePalette.text-primary;
        font-family: ThemePalette.font-family;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
