import { ThemePalette, Scale } from "theme_tokens.slint";

// shortcut: buttons are pointer/touch-driven — no per-control keyboard tab
// focus. The command bar is the keyboard path (fuzzy-launch any app from it)
// and Escape/back dismisses every overlay; upgrade to a focus loop if desktop
// keyboard navigation of individual controls is ever needed.

// One rendered panel position or All-Apps row: an app (id set) or an empty
// holder (placeholder). `icon` is a monogram glyph computed in Rust — no
// image assets, consistent with the text-first design. `accent` is the
// app's own theme colour (derived per id in Rust), so every installed app
// keeps a stable identity across themes.
export struct SlotItem {
    id: string,
    label: string,
    icon: string,
    placeholder: bool,
    accent: color,
}

// One row of the module-store overlay. `status` is pre-rendered by the
// reducer (INSTALL / UPDATE / INSTALLED ✓ / INSTALLING…); `actionable` says
// whether tapping it starts an install.
export struct StoreItem {
    id: string,
    label: string,
    description: string,
    version: string,
    status: string,
    actionable: bool,
}

// Square-ish icon tile + label. Used by the bottom dock (Panel A) and the
// always-visible side rails. A placeholder is an empty app holder: tapping it
// opens the Store so the user can fill the slot.
export component SlotButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> placeholder: false;
    in property <color> accent: ThemePalette.accent-focus;
    callback activated();
    callback open-store();

    background: (touch.pressed || (touch.has-hover && !root.placeholder)) ? ThemePalette.surface-border : ThemePalette.surface-primary;
    border-radius: ThemePalette.corner-radius;
    border-width: ThemePalette.border-width;
    border-color: placeholder ? ThemePalette.canvas-bg : ThemePalette.surface-border;
    opacity: placeholder ? 0.45 : 1.0;

    VerticalLayout {
        alignment: center;
        padding: Scale.space-1;
        spacing: Scale.space-half;

        // Monogram icon tile.
        Rectangle {
            height: 28px;
            width: 28px;
            x: (parent.width - self.width) / 2;
            background: ThemePalette.canvas-bg;
            border-radius: ThemePalette.corner-radius;
            border-width: ThemePalette.border-width;
            border-color: ThemePalette.surface-border;

            Text {
                text: root.placeholder ? "+" : root.icon;
                color: root.placeholder ? ThemePalette.text-secondary : root.accent;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-icon;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.placeholder ? "" : root.label;
            color: ThemePalette.text-primary;
            font-family: ThemePalette.font-family;
            font-size: Scale.font-label;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {

        clicked => {
            if (root.placeholder) {
                root.open-store();
            } else {
                root.activated();
            }
        }
    }
}

// Narrow rail tile for the always-visible side columns: monogram only, no
// label — the rail is ~76px wide and labels would truncate to nothing.
export component RailTile inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> placeholder: false;
    in property <color> accent: ThemePalette.accent-focus;
    callback activated();
    callback open-store();

    height: 56px;
    background: (ta.pressed || (ta.has-hover && !root.placeholder)) ? ThemePalette.surface-border : ThemePalette.canvas-bg;
    border-radius: ThemePalette.corner-radius;
    border-width: ThemePalette.border-width;
    border-color: ThemePalette.surface-border;
    opacity: placeholder ? 0.35 : 1.0;

    Rectangle {
        height: 32px;
        width: 32px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: ThemePalette.surface-primary;
        border-radius: ThemePalette.corner-radius;

        Text {
            text: root.placeholder ? "+" : root.icon;
            color: root.placeholder ? ThemePalette.text-secondary : root.accent;
            font-family: ThemePalette.font-family;
            font-size: Scale.font-icon;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Long-press (or tap on placeholder) surfaces the label + opens store.
    ta := TouchArea {
        clicked => {
            if (root.placeholder) {
                root.open-store();
            } else {
                root.activated();
            }
        }
    }
}

// Full-width row used inside the side drawers and the All Apps overlay.
export component SlotRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> placeholder: false;
    in property <color> accent: ThemePalette.accent-focus;
    callback activated();
    callback open-store();

    height: 52px;
    background: (touch.pressed || (touch.has-hover && !root.placeholder)) ? ThemePalette.surface-border : ThemePalette.canvas-bg;
    border-radius: ThemePalette.corner-radius;
    border-width: ThemePalette.border-width;
    border-color: ThemePalette.surface-border;
    opacity: placeholder ? 0.45 : 1.0;

    HorizontalLayout {
        padding-left: Scale.space-3;
        padding-right: Scale.space-3;
        spacing: Scale.space-3;

        Rectangle {
            width: 32px;
            height: 32px;
            background: ThemePalette.surface-primary;
            border-radius: ThemePalette.corner-radius;

            Text {
                text: root.placeholder ? "+" : root.icon;
                color: root.placeholder ? ThemePalette.text-secondary : root.accent;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-icon;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.placeholder ? "add from store" : root.label;
            color: root.placeholder ? ThemePalette.text-secondary : ThemePalette.text-primary;
            font-family: ThemePalette.font-family;
            font-size: Scale.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.placeholder) {
                root.open-store();
            } else {
                root.activated();
            }
        }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    // Primary actions (install, exit) carry the theme's CTA colour.
    in property <bool> primary: false;
    callback clicked();

    height: Scale.control-height;
    background: touch.pressed ? ThemePalette.surface-border : (root.primary ? ThemePalette.cta-accent : (touch.has-hover ? ThemePalette.surface-border : ThemePalette.surface-primary));
    border-radius: ThemePalette.corner-radius;
    border-width: ThemePalette.border-width;
    border-color: ThemePalette.surface-border;

    Text {
        text: root.text;
        color: root.primary ? ThemePalette.on-cta : ThemePalette.text-primary;
        font-family: ThemePalette.font-family;
        font-size: Scale.font-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
