import { ThemePalette, Scale, Responsive } from "theme_tokens.slint";
import { SlotItem, SlotButton, RailTile, SlotRow, StoreItem, ActionButton, BarPill } from "components.slint";

export { ThemePalette, Responsive, SlotItem, StoreItem }

// Tri-panel shell:
//   centre  = command input + canvas + Panel A dock (bottom thumb zone)
//   left    = Panel B: always-visible rail (compact) / drawer (expanded)
//   right   = Panel C: always-visible rail (compact) / drawer (expanded)
// The rails are app holders, not permanent apps: empty positions are
// placeholders that open the Store. While a module is active (`app-open`)
// every panel vanishes; the home gesture brings them back.
// All gesture *classification* happens in Rust (mandala-core::gesture); this
// file only reports raw pointer down/up events.
export component MainWindow inherits Window {
    title: "Mandala";
    // Explicit size (not `preferred-*`): the padding below is derived from
    // `expanded`, and letting the window auto-size from its content would make
    // that a binding loop (Slint >= 1.10 rejects it at runtime).
    width: 412px;
    height: 915px;
    background: ThemePalette.canvas-bg;

    in property <[SlotItem]> panel-a;
    in property <[SlotItem]> panel-b;
    in property <[SlotItem]> panel-c;
    in property <string> canvas-text;
    in property <string> monitor-text;
    in property <bool> left-open;
    in property <bool> right-open;
    in property <bool> monitor-open;
    in property <bool> store-open;
    in property <bool> apps-open;
    in property <bool> app-open;
    in property <[StoreItem]> store-rows;
    in property <[SlotItem]> app-rows;
    in property <string> store-status;
    in-out property <string> query;
    // Rice layer: wallpaper background + waybar status fields. All values
    // come from real state (context, active theme, install count, clock).
    in property <image> wallpaper-image;
    in property <bool> has-wallpaper: false;
    in property <string> bar-context: "home";
    in property <string> bar-theme;
    in property <string> bar-apps;
    in property <string> bar-clock;

    callback slot-activated(string);
    callback app-activated(string);
    callback open-store();
    callback query-changed(string);
    callback query-submitted();
    callback close-overlays();
    callback pointer-down(float, float);
    callback pointer-up(float, float, float, float);
    callback resized(float);
    callback monitor-unload-all();
    callback monitor-restart-all();
    callback store-install(string);
    callback store-refresh();
    // Back key: closes the nearest overlay, else the open app; never exits.
    callback back();
    // The bottom-left Exit button: the only path that closes the shell.
    callback exit-shell();

    property <bool> expanded: root.width >= 840px;
    property <length> drawer-w: root.expanded ? 320px : 280px;
    property <length> rail-w: 76px;
    // Rails show on phone/foldable widths and vanish while an app is open.
    property <bool> rails-visible: !root.expanded && !root.app-open;
    property <bool> left-visible: root.expanded || root.left-open;
    property <bool> right-visible: root.expanded || root.right-open;
    // Any full-screen overlay hides the panels underneath.
    property <bool> overlay-open: root.monitor-open || root.store-open || root.apps-open;
    // Tab-loop gates: controls hidden behind a modal overlay or an open
    // drawer drop out of the focus chain — the ring would land where
    // nothing can be seen. Drawers docked (expanded) never cover the
    // workspace, so the workspace gate passes there. Rails/drawers stay
    // mounted for their slide animations, so their gates also carry the
    // app-open/visibility state their old `if` used to provide.
    property <bool> workspace-focus: !root.overlay-open && (root.expanded || (!root.left-open && !root.right-open));
    property <bool> left-rail-focus: root.rails-visible && !root.overlay-open && !root.left-open;
    property <bool> right-rail-focus: root.rails-visible && !root.overlay-open && !root.right-open;
    property <bool> left-drawer-focus: root.left-visible && !root.overlay-open && !root.app-open;
    property <bool> right-drawer-focus: root.right-visible && !root.overlay-open && !root.app-open;

    init => {
        Responsive.window-width = root.width;
        root.resized(root.width / 1px);
    }
    changed width => {
        Responsive.window-width = root.width;
        root.resized(root.width / 1px);
    }

    // Rice wallpaper: the surface the glass panels sit on. Hidden until a
    // wallpaper path is set (the opaque canvas-bg shows through underneath).
    Image {
        visible: root.has-wallpaper;
        source: root.wallpaper-image;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        image-fit: cover;
    }

    // Escape (and, on Android, the system back key, which slint delivers the
    // same way) walks back one level. Two scopes cover every focus state:
    // this one holds focus whenever no other element does (init), and the
    // workspace scope below catches Escape rejected by the text input.
    back_idle := FocusScope {
        // Parks the initial focus only: Escape/back works before anything
        // is clicked, but Tab skips straight past it to the command bar.
        focus-on-tab-navigation: false;
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == "\u{1b}" {
                root.back();
                accept
            } else if e.modifiers.control && e.text == " " {
                // Ctrl+Space: the rofi/SUPER+D launcher role — jump to the
                // command bar (workspace only; overlays keep their focus).
                if root.workspace-focus {
                    input.focus();
                }
                accept
            } else if e.modifiers.control && (e.text == "t" || e.text == "T") {
                // Ctrl+T: the terminal, straight from anywhere on the
                // workspace (same slot path as tapping the dock tile).
                if root.workspace-focus {
                    root.slot-activated("app-terminal");
                }
                accept
            } else {
                reject
            }
        }
    }

    // Bottom-most layer: raw pointer capture for the gesture engine.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pointer-down(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if (event.kind == PointerEventKind.up) {
                root.pointer-up(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px);
            }
        }
    }

    // Centre workspace. FocusScope so Escape rejected by the query input
    // (which never consumes it) still bubbles into the back handler.
    workspace_keys := FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            if e.text == "\u{1b}" {
                root.back();
                accept
            } else if e.modifiers.control && e.text == " " {
                // Ctrl+Space: the rofi/SUPER+D launcher role — jump to the
                // command bar (workspace only; overlays keep their focus).
                if root.workspace-focus {
                    input.focus();
                }
                accept
            } else if e.modifiers.control && (e.text == "t" || e.text == "T") {
                // Ctrl+T: the terminal, same slot path as the dock tile.
                if root.workspace-focus {
                    root.slot-activated("app-terminal");
                }
                accept
            } else {
                reject
            }
        }
    VerticalLayout {
        padding-left: root.app-open ? 24px : (root.expanded ? root.drawer-w + 24px : (root.rails-visible ? root.rail-w + 16px : 24px));
        padding-right: root.app-open ? 24px : (root.expanded ? root.drawer-w + 24px : (root.rails-visible ? root.rail-w + 16px : 24px));
        padding-top: Scale.space-10;
        padding-bottom: Scale.space-5;
        spacing: Scale.space-4;

        // Hyprland-style glide: the whole workspace slides sideways as the
        // app opens/closes (the padding class changes with `app-open`).
        animate padding-left { duration: 180ms; easing: ease-out; }
        animate padding-right { duration: 180ms; easing: ease-out; }
        animate padding-top { duration: 180ms; easing: ease-out; }

        Rectangle {
            height: Scale.control-height;
            background: ThemePalette.surface-primary;
            border-radius: ThemePalette.corner-radius;
            border-width: ThemePalette.border-width;
            border-color: input.has-focus ? ThemePalette.accent-focus : ThemePalette.surface-border;

            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: "search or type a command";
                color: ThemePalette.text-secondary;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-body;
                vertical-alignment: center;
                visible: root.query == "";
            }

            input := TextInput {
                enabled: root.workspace-focus;
                x: Scale.space-3;
                width: parent.width - (Scale.space-3 * 2);
                height: parent.height;
                text <=> root.query;
                color: ThemePalette.text-primary;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-input;
                vertical-alignment: center;
                single-line: true;
                edited => { root.query-changed(self.text); }
                accepted => { root.query-submitted(); }
            }
        }

        Flickable {
            vertical-stretch: 1;
            Text {
                width: parent.width;
                text: root.canvas-text;
                color: ThemePalette.text-primary;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-body;
                wrap: word-wrap;
            }
        }

        // Panel A: bottom dock, resting thumb zone. Vanishes while an app
        // is open so the module gets the full screen.
        if !root.app-open: HorizontalLayout {
            height: 64px;
            spacing: Scale.space-2;
            for slot in root.panel-a: SlotButton {
                focusable: root.workspace-focus;
                icon: slot.icon;
                label: slot.label;
                placeholder: slot.placeholder;
                accent: slot.accent;
                activated => { root.slot-activated(slot.id); }
                open-store => { root.open-store(); }
            }
        }
    }
    }

    // Left rail: app holders on phone widths. Mounted permanently so the
    // slide plays in both directions; the off-screen position plus the
    // `left-rail-focus` gate keep it inert while hidden.
    Rectangle {
        x: root.rails-visible ? 0px : -root.rail-w;
        animate x { duration: 180ms; easing: ease-out; }
        width: root.rail-w;
        height: root.height;
        background: ThemePalette.canvas-bg;
        border-color: ThemePalette.surface-border;
        border-width: ThemePalette.border-width;

        VerticalLayout {
            padding: Scale.space-2;
            padding-top: Scale.gutter-rail-top;
            padding-bottom: Scale.space-2;
            spacing: Scale.space-2;
            for slot in root.panel-b: RailTile {
                focusable: root.left-rail-focus;
                icon: slot.icon;
                label: slot.label;
                placeholder: slot.placeholder;
                accent: slot.accent;
                activated => { root.slot-activated(slot.id); }
                open-store => { root.open-store(); }
            }
            Rectangle { vertical-stretch: 1; }
            // The only exit of the whole shell, pinned bottom-left of home.
            ActionButton {
                focusable: root.left-rail-focus;
                text: "EXIT";
                primary: true;
                clicked => { root.exit-shell(); }
            }
        }
    }

    // Right rail: app holders on phone widths (same slide model as left).
    Rectangle {
        x: root.rails-visible ? root.width - root.rail-w : root.width;
        animate x { duration: 180ms; easing: ease-out; }
        width: root.rail-w;
        height: root.height;
        background: ThemePalette.canvas-bg;
        border-color: ThemePalette.surface-border;
        border-width: ThemePalette.border-width;

        VerticalLayout {
            padding: Scale.space-2;
            padding-top: Scale.gutter-rail-top;
            spacing: Scale.space-2;
            alignment: start;
            for slot in root.panel-c: RailTile {
                focusable: root.right-rail-focus;
                icon: slot.icon;
                label: slot.label;
                placeholder: slot.placeholder;
                accent: slot.accent;
                activated => { root.slot-activated(slot.id); }
                open-store => { root.open-store(); }
            }
        }
    }

    // Dim scrim behind a compact-mode drawer; also forwards swipes so a
    // swipe-to-close works anywhere outside the drawer. Mounted so the
    // fade-in plays; `visible` keeps it out of hit-testing when closed.
    Rectangle {
        visible: (root.left-open || root.right-open) && !root.expanded;
        opacity: ((root.left-open || root.right-open) && !root.expanded) ? 1.0 : 0.0;
        animate opacity { duration: 150ms; easing: ease-out; }
        background: ThemePalette.overlay-scrim;
        TouchArea {
            clicked => { root.close-overlays(); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.pointer-down(self.mouse-x / 1px, self.mouse-y / 1px);
                } else if (event.kind == PointerEventKind.up) {
                    root.pointer-up(self.mouse-x / 1px, self.mouse-y / 1px, root.width / 1px, root.height / 1px);
                }
            }
        }
    }

    // Panel B: left drawer (gesture-opened; slides over the rail). Mounted
    // for the slide; hidden while an app owns the screen.
    Rectangle {
        visible: !root.app-open;
        width: root.drawer-w;
        height: root.height;
        x: root.left-visible ? 0px : -root.drawer-w;
        animate x { duration: 180ms; easing: ease-out; }
        background: ThemePalette.surface-primary;
        border-color: ThemePalette.surface-border;
        border-width: ThemePalette.border-width;

        VerticalLayout {
            padding: Scale.space-4;
            padding-top: Scale.gutter-top;
            spacing: Scale.space-2;
            for slot in root.panel-b: SlotRow {
                focusable: root.left-drawer-focus;
                icon: slot.icon;
                label: slot.label;
                placeholder: slot.placeholder;
                accent: slot.accent;
                activated => { root.slot-activated(slot.id); }
                open-store => { root.open-store(); }
            }
            Rectangle { vertical-stretch: 1; }
            // Same exit affordance on the docked/open drawer (expanded layout).
            ActionButton {
                focusable: root.left-drawer-focus;
                text: "EXIT";
                primary: true;
                clicked => { root.exit-shell(); }
            }
        }
    }

    // Panel C: right drawer (gesture-opened; slides over the rail).
    Rectangle {
        visible: !root.app-open;
        width: root.drawer-w;
        height: root.height;
        x: root.right-visible ? root.width - root.drawer-w : root.width;
        animate x { duration: 180ms; easing: ease-out; }
        background: ThemePalette.surface-primary;
        border-color: ThemePalette.surface-border;
        border-width: ThemePalette.border-width;

        VerticalLayout {
            padding: Scale.space-4;
            padding-top: Scale.gutter-top;
            spacing: Scale.space-2;
            for slot in root.panel-c: SlotRow {
                focusable: root.right-drawer-focus;
                icon: slot.icon;
                label: slot.label;
                placeholder: slot.placeholder;
                accent: slot.accent;
                activated => { root.slot-activated(slot.id); }
                open-store => { root.open-store(); }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

    // All Apps overlay (the A3 builtin slot): every installed app as a
    // tappable row with its monogram, plus a Store row. Replaces the old
    // non-interactive text listing. Mounted so it can fade in; `visible`
    // keeps it out of rendering, hit-testing and the Tab loop.
    Rectangle {
        visible: root.apps-open;
        opacity: root.apps-open ? 1.0 : 0.0;
        animate opacity { duration: 150ms; easing: ease-out; }
        background: ThemePalette.canvas-bg;

        // Swallow input so nothing underneath is triggered.
        TouchArea { }

        VerticalLayout {
            padding: Scale.space-6;
            padding-top: Scale.gutter-top;
            spacing: Scale.space-3;

            Text {
                text: "ALL APPS";
                color: ThemePalette.text-secondary;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-caption;
            }

            if root.app-rows.length == 0: Text {
                text: "No apps installed yet.\nOpen the Store to install your first module.";
                color: ThemePalette.text-secondary;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-body;
                wrap: word-wrap;
            }

            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-2;
                    for row in root.app-rows: SlotRow {
                        focusable: root.apps-open;
                        icon: row.icon;
                        label: row.label;
                        placeholder: row.placeholder;
                        accent: row.accent;
                        activated => { root.app-activated(row.id); }
                        open-store => { root.open-store(); }
                    }
                }
            }

            ActionButton {
                focusable: root.apps-open;
                text: "CLOSE";
                clicked => { root.close-overlays(); }
            }
        }
    }

    // Module process monitor (double swipe-up / hold on the bottom anchor).
    Rectangle {
        visible: root.monitor-open;
        opacity: root.monitor-open ? 1.0 : 0.0;
        animate opacity { duration: 150ms; easing: ease-out; }
        background: ThemePalette.canvas-bg;

        // Swallow input so nothing underneath is triggered.
        TouchArea { }

        VerticalLayout {
            padding: Scale.space-6;
            padding-top: Scale.gutter-top;
            spacing: Scale.space-3;

            Flickable {
                vertical-stretch: 1;
                Text {
                    width: parent.width;
                    text: root.monitor-text;
                    color: ThemePalette.text-primary;
                    font-family: Scale.font-mono;
                    font-size: Scale.font-small;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                height: Scale.control-height;
                spacing: Scale.space-2;
                ActionButton {
                    focusable: root.monitor-open;
                    text: "UNLOAD ALL";
                    clicked => { root.monitor-unload-all(); }
                }
                ActionButton {
                    focusable: root.monitor-open;
                    text: "RESTART";
                    clicked => { root.monitor-restart-all(); }
                }
                ActionButton {
                    focusable: root.monitor-open;
                    text: "CLOSE";
                    clicked => { root.close-overlays(); }
                }
            }
        }
    }

    // Module store (the `store` command). Rows come straight from the
    // catalog; statuses are computed by the reducer from on-disk state.
    Rectangle {
        visible: root.store-open;
        opacity: root.store-open ? 1.0 : 0.0;
        animate opacity { duration: 150ms; easing: ease-out; }
        background: ThemePalette.canvas-bg;

        // Swallow input so nothing underneath is triggered.
        TouchArea { }

        VerticalLayout {
            padding: Scale.space-6;
            padding-top: Scale.gutter-top;
            spacing: Scale.space-3;

            Text {
                text: "MODULE STORE";
                color: ThemePalette.text-secondary;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-caption;
            }

            Text {
                text: root.store-status;
                color: ThemePalette.text-secondary;
                font-family: ThemePalette.font-family;
                font-size: Scale.font-small;
                wrap: word-wrap;
            }

            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: Scale.space-2;
                    for item in root.store-rows: Rectangle {
                        height: 64px;
                        background: ThemePalette.surface-primary;
                        border-radius: ThemePalette.corner-radius;
                        border-width: ThemePalette.border-width;
                        border-color: ThemePalette.surface-border;

                        HorizontalLayout {
                            padding-left: Scale.space-3;
                            padding-right: Scale.space-3;
                            spacing: Scale.space-3;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Scale.space-half;

                                Text {
                                    text: item.label + "  " + item.version;
                                    color: ThemePalette.text-primary;
                                    font-family: ThemePalette.font-family;
                                    font-size: Scale.font-body;
                                }
                                Text {
                                    text: item.description;
                                    color: ThemePalette.text-secondary;
                                    font-family: ThemePalette.font-family;
                                    font-size: Scale.font-caption;
                                    overflow: elide;
                                }
                            }

                            if item.actionable: ActionButton {
                                focusable: root.store-open;
                                width: 110px;
                                text: item.status;
                                primary: true;
                                clicked => { root.store-install(item.id); }
                            }
                            if !item.actionable: Text {
                                text: item.status;
                                color: ThemePalette.text-secondary;
                                font-family: ThemePalette.font-family;
                                font-size: Scale.font-caption;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: Scale.control-height;
                spacing: Scale.space-2;
                ActionButton {
                    focusable: root.store-open;
                    text: "REFRESH";
                    clicked => { root.store-refresh(); }
                }
                ActionButton {
                    focusable: root.store-open;
                    text: "CLOSE";
                    clicked => { root.close-overlays(); }
                }
            }
        }
    }

    // waybar-style status bar (rice layer): live context, active theme,
    // install count and clock — all real state, status only (no pointer
    // handling, never focusable). Declared last so it sits above overlays,
    // clearing them via their `padding-top: gutter-top`.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: Scale.bar-height;
        background: ThemePalette.surface-primary;
        border-width: ThemePalette.border-width;
        border-color: ThemePalette.surface-border;

        HorizontalLayout {
            padding-left: Scale.space-2;
            padding-right: Scale.space-2;
            spacing: Scale.space-2;

            BarPill { text: root.bar-context; }
            BarPill { text: root.bar-theme; accent: true; }
            BarPill { text: root.bar-apps; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            BarPill { text: root.bar-clock; }
        }
    }
}
