<?xml version="1.0" encoding="utf-8"?>
<!--
  Paths that the launcher's FileProvider may expose to other apps.

  Only the app-private files root is shared, and only for the camera intent's
  EXTRA_OUTPUT URI: the camera app gets a one-shot write grant for a single
  file, not read access to the home directory. `<files-path>` resolves to
  `Context.getFilesDir()`, which is the root Slint hands to `android_main` via
  `internal_data_path()`; captures land in `data/app-camera/captures/`.

  Keep the authority in sync with AndroidManifest.xml (`${applicationId}.fileprovider`)
  and with `crates/mandala-shell/src/android.rs`.
-->
<paths>
    <files-path name="mandala_home" path="." />
</paths>
