<?xml version="1.0" encoding="utf-8"?>
<!--
  Mandala launcher manifest template.

  Build the native library first (`scripts/android-build.sh`), then drop this
  file and the generated `jniLibs/` into an Android Gradle project (or wrap it
  with `cargo-apk`). `android.app.lib_name` must match the cdylib produced by
  the `mandala-shell` package: `libmandala_shell.so` -> `mandala_shell`.

  Permissions:
    SET_WALLPAPER        `wallpaper <path>` command (JNI WallpaperManager)
    SYSTEM_ALERT_WINDOW  overlay; requested at runtime by `overlay`
    INTERNET             LAN sockets used by the LocalSend module

  The FileProvider entry makes `camera` able to hand the user's camera app a
  `content://` URI for the full-size photo (C5). It needs `androidx.core` on
  the Gradle classpath; without it the shell falls back to `file://`, which
  Android rejects on API 24+ — the command then reports that plainly instead
  of pretending the photo was saved. See android/res/xml/file_paths.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.mandala.launcher">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Capture uses the user's camera app, so a camera is not required. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="Mandala"
        android:hasCode="false"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="mandala_shell" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Literal authority, not ${applicationId}: only the Gradle plugin
             substitutes that placeholder, so any packaging path without Gradle
             (aapt2 directly) would ship the literal string and the runtime
             authority lookup (getPackageName() + ".fileprovider") would miss.
             The application id equals the package here, so both paths agree. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.mandala.launcher.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
